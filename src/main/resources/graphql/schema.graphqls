# PHOTATO GraphQL 스키마 v2.0
#
# [인증 전제]
# - 카카오 OAuth 로그인/토큰 발급은 REST로 처리한다. (POST /api/auth/kakao 등 — 명세 별도 확정)
#   GraphQL은 로그인 이후, Authorization: Bearer <accessToken> 헤더로 사용자를 식별한다.
# - 따라서 모든 Query/Mutation은 "로그인된 사용자" 기준으로 동작한다.
#   토큰이 없거나 만료되면 GraphQL errors로 UNAUTHENTICATED 를 반환한다.
#
# [권한 전제]
# - party 관련 조회/변경은 "요청자가 해당 팟의 멤버"임을 서버가 검증한다.
#   멤버가 아닌 팟의 partyId로 요청하면 FORBIDDEN 을 반환한다.
# - owner 전용 액션(deleteParty, kickMember, regenerateInviteCode)은
#   요청자가 owner여야 하며, 아니면 FORBIDDEN.
#   팟 이름 변경(renameParty)은 owner 전용이 아니다 — 멤버면 누구나 할 수 있다.
#
# [에러 규격]
# - GraphQL 표준 errors 배열을 사용하고, extensions.code 로 분기 가능한 코드를 내려준다.
# - 사용하는 코드 목록:
#   UNAUTHENTICATED / FORBIDDEN / PARTY_NOT_FOUND / TRIP_NOT_FOUND / IMAGE_NOT_FOUND
#   / REGION_NOT_FOUND / MEMBER_NOT_FOUND / INVALID_INVITE_CODE / IMAGE_NOT_UPLOADED
#   / INVITE_CODE_CONFLICT / ALREADY_JOINED_PARTY / PARTY_FULL / CANNOT_REMOVE_OWNER
#   / OWNER_CANNOT_LEAVE / RATE_LIMITED / VALIDATION_ERROR
#   / TRIP_RECORD_NOT_FOUND / REGION_HAS_INCOMPLETE_TRIP
#
# [여행 모델 — v2에서 바뀐 핵심]
# - Trip = "팟의 한 번의 방문"(지역 + 기간 + 키워드). 팟 전체가 공유한다.
# - TripMemberRecord = 그 방문에 대한 "멤버 1명의 기록"(사진 + 코멘트).
#   Trip.records 는 팟 멤버 전원을 한 행씩 내려주며, 아직 안 올린 멤버는 recorded=false 인 빈 행이다.
# - 같은 지역 재방문 = 새 Trip. 이미 있는 Trip에 내 기록만 얹는 것은 recordTrip.
# - regionCode는 숫자가 아니라 문자열이다. 자릿수가 레벨마다 다르고(광역시·도 2자리, 시·군·구 5자리)
#   프론트 GeoJSON의 properties.code와 그대로 대조해야 하므로, 숫자로 바꿔 선행 0이 날아가면 안 된다.
#
# [이미지 업로드 플로우]
# - createImageUploadUrl → 프론트가 uploadUrl로 PUT 업로드 → imageId를 createTrip/recordTrip에 전달.
# - 썸네일은 백그라운드 생성. null이면 프론트가 originalUrl로 대체 표시.
# - 이미지 내부 처리 상태는 GraphQL로 노출하지 않는다.
#
# [목록 반환 정책]
# - v2의 모든 목록은 배열로 반환한다. (페이지네이션 없음)

"ISO-8601 날짜. 예: \"2026-07-09\""
scalar Date

"ISO-8601 날짜+시간. 예: \"2026-07-09T12:34:56\""
scalar DateTime

type Query {
    """
    내 프로필 (토큰 기준).
    """
    me: User!

    """
    내가 속한 여행팟 목록, 소속 팟이 없으면 빈 배열.
    정렬: 내가 참여한 시각 내림차순 — 가장 최근에 들어간 팟이 맨 위다. (마이페이지 "내 팟" 순서)
    """
    myParties: [Party!]!

    "팟 상세 (멤버 목록 포함). 내가 멤버가 아니면 FORBIDDEN."
    partyDetail(partyId: ID!): Party!

    """
    초대코드로 받은 팟 미리보기 — 참여 확정 전 확인 모달용. 실제 참여는 joinParty 뮤테이션.
    """
    partyPreview(inviteCode: String!): PartyPreview!

    """
    팟의 전체 여행 목록
    정렬: 최신순 확정 — startDate 내림차순, 동률이면 createdAt 내림차순.
    """
    partyTrips(partyId: ID!): [Trip!]!

    "특정 지역의 여행만 — 정렬 기준은 partyTrips와 동일."
    partyTripsInRegion(partyId: ID!, regionCode: String!): [Trip!]!

    """
    팟이 방문한 지역 목록 — 여행 이미지 상세 보기 진입 화면.
    지역마다 방문 횟수·대표 사진·내 미기록 여부가 함께 온다.
    """
    partyVisitedRegions(partyId: ID!): [VisitedRegion!]!

    """
    팟 지도 — 줌 0~3단계 집계를 한 번에 내려준다.
    줌·이동으로는 재호출하지 않는다. 여행 등록/삭제 후에만 다시 부른다.
    내가 멤버가 아니면 FORBIDDEN.
    """
    partyMapOverview(partyId: ID!): PartyMapOverview!

    # TODO: 여행리캡 확정 후 변경 예정
    "팟의 여행 전체 집계 (리캡 이미지용)"
    partyTripStats(partyId: ID!): TripStats!
}

type Mutation {
    "닉네임/프로필 이미지 설정 (가입 직후 온보딩 포함)."
    updateProfile(input: UpdateProfileInput!): User!

    """
    계정 탈퇴. 성공 시 탈퇴한 사용자의 id를 반환.
    [정책] 업로드한 모든 사진이 서버에서 영구 삭제된다.
    소속된 모든 팟에서 탈퇴 처리되며 팟 자체는 유지된다(공석 전환) — 팟 나가기(leaveParty)와 동일한 규칙을 적용한다.
    owner였던 팟은 남은 멤버 중 가장 먼저 참여한 사람에게 자동으로 위임되고, 혼자 남은 팟이면 팟 자체가 함께 삭제된다.
    """
    withdraw: ID!

    "여행팟 생성 — 6자리 초대코드가 발급된다. 생성자는 자동으로 owner이자 멤버가 된다."
    createParty(name: String!): Party!

    """
    팟 이름 변경. 성공 시 갱신된 Party를 반환.
    이름 규칙은 createParty와 같다 — 1자 이상이면 되고 공백·중복·특수기호를 가리지 않는다.
    [정책] owner 전용이 아니다. 멤버 누구나 바꿀 수 있고, 멤버가 아니면 FORBIDDEN.
    """
    renameParty(partyId: ID!, name: String!): Party!

    """
    초대코드로 팟 참여.
    코드가 틀리면 INVALID_INVITE_CODE, 이미 멤버면 ALREADY_JOINED_PARTY.
    최대 인원 6명을 초과하면 PARTY_FULL.
    무차별 대입 방지를 위해 서버 rate limit 적용 — 초과 시 RATE_LIMITED.
    """
    joinParty(inviteCode: String!): Party!

    """
    초대코드 재발급 (owner 전용). 기존 코드는 즉시 무효화되고, 새 6자리 코드가 반영된 Party를 반환한다.
    코드 발급 경합이 발생하면 INVITE_CODE_CONFLICT.
    owner가 아니면 FORBIDDEN.
    """
    regenerateInviteCode(partyId: ID!): Party!

    """
    팟 나가기. 성공 시 나간 팟(또는 삭제된 팟)의 id를 반환.
    [정책] owner가 나가면 남은 멤버 중 가장 먼저 참여한 사람에게 owner가 자동으로 위임된다.
    혼자 남은 owner가 나가면 deleteParty와 동일하게 팟 자체가 삭제된다.
    나가는 멤버가 이 팟에 남긴 기록(사진/코멘트)은 서버에서 영구 삭제되며, 팟과 다른 멤버 데이터는 유지된다.
    """
    leaveParty(partyId: ID!): ID!

    """
    팟 삭제 (owner 전용). 성공 시 삭제된 팟의 id를 반환.
    [정책] 다른 멤버가 남아 있어도 삭제할 수 있다. owner가 아니면 FORBIDDEN.
    팟과 그 안의 모든 데이터(멤버십/여행/기록/이미지)가 서버에서 영구 삭제되고, 초대코드도 즉시 만료된다.
    """
    deleteParty(partyId: ID!): ID!

    """
    멤버 강퇴 (owner 전용). 성공 시 갱신된 Party를 반환.
    대상이 이 팟의 멤버가 아니면 MEMBER_NOT_FOUND.
    owner 자신을 강퇴 대상으로 지정하면 CANNOT_REMOVE_OWNER. owner가 아니면 FORBIDDEN.
    """
    kickMember(input: KickMemberInput!): Party!

    """
    이미지 업로드 URL 발급 (presigned URL 방식)
      1) 이 뮤테이션으로 imageId + uploadUrl 발급
      2) 발급받은 uploadUrl로 원본 PUT 업로드
      3) imageId를 createTrip/recordTrip에 전달
    """
    createImageUploadUrl(input: CreateImageUploadUrlInput!): ImageUploadTarget!

    """
    새 방문 등록 — 지역 + 기간 + 키워드를 확정하고, 내 기록(사진 1장 + 코멘트)까지 함께 남긴다.
    같은 지역을 다시 방문했다면 이 뮤테이션으로 새 Trip을 만든다 (기존 기록에 덮어쓰지 않는다).
    - 존재하지 않는 imageId면 IMAGE_NOT_FOUND, 존재하지 않는 regionCode면 REGION_NOT_FOUND.
    - startDate <= endDate 를 서버가 검증한다.

    [정책] 같은 지역의 이전 방문이 전부 끝나야 다음 방문을 등록할 수 있다.
    미완료 방문이 남아 있으면 REGION_HAS_INCOMPLETE_TRIP —
    프론트는 "모두가 기록해야 다음 여행을 기록할 수 있어요!" 토스트를 띄운다.
    "끝났다"의 기준은 현재 팟 멤버 전원이 기록을 남겼는지다. 기록하지 않고 나가거나 강퇴된 멤버는 세지 않아,
    그 방문은 자동으로 완료로 넘어간다. 잠금은 같은 지역에만 걸린다 — 다른 지역은 자유롭게 등록할 수 있다.
    """
    createTrip(input: CreateTripInput!): Trip!

    """
    이미 있는 여행에 내 기록을 남긴다
    내 기록이 이미 있으면 사진/코멘트를 통째로 교체한다(upsert). 연결이 끊긴 사진은 서버가 정리한다.
    이 팟의 멤버가 아니면 FORBIDDEN.
    """
    recordTrip(input: RecordTripInput!): Trip!

    """
    내 기록만 삭제 (사진 + 코멘트). 여행 자체와 다른 멤버의 기록은 남는다.
    내 기록이 없으면 TRIP_RECORD_NOT_FOUND.
    [정책] 삭제 결과 아무 기록도 남지 않으면 여행 자체가 사라지고 null을 반환한다.
    """
    deleteTripRecord(tripId: ID!): Trip
}

"서비스 사용자. 팟/여행 문맥과 무관한 전역 프로필."
type User {
    id: ID!
    nickname: String!
    "프리셋 아바타 코드(1~4) 또는 업로드한 사진의 imageId. 미설정 시 서버가 기본값을 채워 내려준다. (null 아님)"
    profileImage: ID!
    """
    업로드한 프로필 사진의 URL. profileImage가 프리셋 코드(1~4)면 null — 그때는 프론트가 코드로 내장 이미지를 렌더링한다.
    [주의] 현재 me 쿼리에서만 채워진다. 다른 곳(파티 멤버 등)의 User는 항상 null.
    """
    profileImageUrl: String
}

type Party {
    id: ID!
    name: String!
    "6자리 초대코드"
    inviteCode: String!
    owner: User!
    "owner 포함 전체 멤버. 최대 6명. 가입 순서 정렬(owner가 항상 첫 번째)."
    members: [User!]!
    createdAt: DateTime!
}

"참여 확정 전에 보여주는 팟 요약. 초대코드는 포함하지 않는다."
type PartyPreview {
    name: String!
    "\"n/6명 참여 중\"의 n"
    memberCount: Int!
    "가입 순서 정렬"
    members: [User!]!
}

"""
기록하기 플로우에서 고르는 여행 키워드 5종. 기존 color를 대체한다.
나열 순서는 기획의 칩 노출 순서(맛집·디저트·힐링·액티비티·사진)와 같다.
지도 채색 색상과 스티커 이모지는 프론트가 이 값에 매핑한다.
"""
enum TripKeyword {
    "맛집"
    FOOD
    "디저트"
    DESSERT
    "힐링"
    HEALING
    "액티비티"
    ACTIVITY
    "사진"
    PHOTO
}

"팟의 한 번의 방문. 지역/기간/키워드는 팟 전체가 공유하고, 사진과 코멘트는 records에 담긴다."
type Trip {
    id: ID!
    regionCode: String!
    keyword: TripKeyword!
    startDate: Date!
    endDate: Date!
    "이 지역의 몇 번째 방문인지 (1부터). \"N번째 방문\" 라벨용."
    visitSequence: Int!
    """
    팟 멤버 전원의 기록 행. 아직 안 올린 멤버도 recorded=false 로 포함된다.
    정렬: 내 기록 최상단 고정 → 이후 팟 가입 순서.
    """
    records: [TripMemberRecord!]!
    createdAt: DateTime!
}

"여행 기록 — 멤버 1명."
type TripMemberRecord {
    member: User!
    recorded: Boolean!
    comment: String
    "[정책] 기록 1건에 사진 1장. 아직 안 올린 멤버(recorded=false)는 null."
    image: Image
}

"여행 이미지 상세 보기 진입 화면의 지역 카드."
type VisitedRegion {
    "행정구역 코드. 광역시·도는 2자리, 시·군·구는 5자리다. (예: \"11\", \"31010\")"
    regionCode: String!
    "\"N회\" — 이 지역 방문 횟수. 기록하기 화면의 다음 회차는 visitCount + 1."
    visitCount: Int!
    "스택(콜라주)용 대표 사진. 팟 전원 사진을 최신순으로 추린 것."
    images: [Image!]!
    "이 지역의 전체 사진 수. 스택에 담기지 않은 \"+N\" 계산용."
    totalImageCount: Int!
    "이 지역 방문 중 내가 기록하지 않은 게 있으면 true → \"아직 기록하지 않은 여행이 있어요\""
    hasUnrecordedTrip: Boolean!
}

type Image {
    id: ID!
    originalUrl: String!
    "[정책] 썸네일 생성 전이면 null. 프론트는 null일 때 originalUrl로 대체 표시한다."
    thumbnailUrl: String
    "업로더 (탈퇴한 사용자면 null)"
    uploader: User
    createdAt: DateTime!
}

"\"200일 동안 5개 도시\" 티켓용 통계"
type TripStats {
    "여행 횟수"
    tripCount: Int!
    "방문한 지역(시·군·구) 수 (중복 지역은 1로 계산)"
    regionCount: Int!
    "[정책] 여행 일수 합계. 기간이 겹쳐도 각 여행 일수를 단순 합산한다."
    totalTravelDays: Int!
    firstTripDate: Date
    lastTripDate: Date
}

"""
지도 한 화면 분의 집계.
폴리곤 좌표는 내려주지 않는다 — 프론트 GeoJSON의 properties.code와 regionCode를 대조해 칠하는 조회표다.
"""
type PartyMapOverview {
    "\"n/N\" 배지의 분모. 칸마다 같은 값이라 여기 한 번만 둔다."
    memberCount: Int!
    "0단계 — 전국을 하나로 묶은 칸. 여행이 하나도 없으면 null."
    country: MapCell
    "1단계 — 시·도 단위. 방문한 시·도만 담긴다. regionCode 오름차순."
    provinces: [MapCell!]!
    "2·3단계 — 시·군·구 단위. 방문한 지역만 담긴다. regionCode 오름차순."
    municipalities: [MapCell!]!
}

"지도에서 색칠되는 구역 하나."
type MapCell {
    """
    프론트 GeoJSON의 properties.code와 대조할 코드.
    country는 "KR" 고정, provinces는 2자리, municipalities는 trip에 기록된 값 그대로다.
    [주의] 광역시 여행은 municipalities에도 2자리 코드("11")로 들어온다.
    자릿수가 곧 폴리곤 출처다 — 2자리는 시·도 GeoJSON, 5자리는 시·군·구 GeoJSON에서 찾는다.
    """
    regionCode: String!
    "대표 키워드 스티커. 최빈 → 동률이면 최근 방문 → 그래도 동률이면 나중에 등록된 여행."
    keyword: TripKeyword!
    "\"+N\" 배지 — 이 칸에서 다녀온 서로 다른 시·군·구 수. 같은 지역 재방문은 1로 센다."
    regionCount: Int!
    "이 칸 안의 총 방문 횟수. 같은 지역 재방문도 각각 센다."
    visitCount: Int!
    "\"n/N\"의 n — 이 칸에 기록을 남긴 서로 다른 현재 멤버 수. 탈퇴/강퇴된 멤버의 기록은 세지 않는다."
    recordedMemberCount: Int!
    """
    이 칸에 내가 아직 기록하지 않은 여행이 하나라도 있으면 true.
    [정책] true면 스티커·색상을 칠하지 않고 회색으로 두고, "탭해서 기록하기" 툴팁과 "n/N"만 얹는다.
    같은 지역을 여러 번 다녀왔다면 그중 하나만 안 올려도 true다 —
    1차를 내가 기록했더라도 2차가 비어 있으면 그 칸은 다시 회색으로 돌아간다.
    """
    hasUnrecordedTrip: Boolean!
    """
    이 칸에서 가장 나중에 등록된 여행의 등록 시각.
    "[{지역이름} 기록하기] 툴팁은 가장 최근 등록된 지역 1곳에만" 규칙을 프론트가 이 값으로 고른다 —
    hasUnrecordedTrip이 true인 칸 중 이 값이 가장 큰 하나에만 버튼 툴팁을 붙이면 된다.
    """
    latestTripAt: DateTime!
}

input UpdateProfileInput {
    nickname: String!
    "미전달(null) 시 기존 값 유지. 프리셋 아바타 코드(1~4) 또는 업로드한 사진의 imageId."
    profileImage: ID
}

input KickMemberInput {
    partyId: ID!
    "강퇴할 대상 사용자 id"
    targetUserId: ID!
}

input CreateImageUploadUrlInput {
    "예: \"image/jpeg\". 허용: image/jpeg, image/png, image/webp"
    contentType: String!
}

type ImageUploadTarget {
    imageId: ID!
    "이 URL로 PUT 업로드. 만료 시간 존재 (협의 중)."
    uploadUrl: String!
}

"기록에 붙일 사진 1장."
input TripImageInput {
    "업로드까지 끝낸 imageId"
    imageId: ID!
    "촬영일. 갤러리 최신순 정렬 기준. 미전달 시 등록 순서로 밀린다."
    takenAt: Date
}

input CreateTripInput {
    partyId: ID!
    regionCode: String!
    keyword: TripKeyword!
    startDate: Date!
    endDate: Date!
    image: TripImageInput!
    comment: String
}

input RecordTripInput {
    tripId: ID!
    "기존 내 사진을 이 사진으로 교체한다."
    image: TripImageInput!
    comment: String
}
